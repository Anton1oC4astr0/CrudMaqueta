<Window x:Class="CrudMaqueta.Views.VentanaAltas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alta de Alumno" Height="530" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30,30,27,30">

        <Label Content="Alta de Alumno" FontSize="22" FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <!-- Información de Identificación -->
        <Label Content="No. Control:" Margin="0,60,0,0"
               VerticalAlignment="Top" FontSize="14"/>
        <TextBox x:Name="txtNumControl" Margin="140,63,0,0" Width="270"
                 Height="28" VerticalAlignment="Top" FontSize="14"
                 HorizontalAlignment="Left"/>

        <!-- Información Personal -->
        <Label Content="Nombre:" Margin="0,105,0,0"
               VerticalAlignment="Top" FontSize="14"/>
        <TextBox x:Name="txtNombre" Margin="140,108,0,0" Width="270"
                 Height="28" VerticalAlignment="Top" FontSize="14"
                 HorizontalAlignment="Left"/>

        <Label Content="Fecha Nac:" Margin="0,150,0,0"
               VerticalAlignment="Top" FontSize="14"/>
        <DatePicker x:Name="dpFechaNac" Margin="140,153,0,0" Width="270"
                    Height="28" VerticalAlignment="Top" FontSize="14"
                    HorizontalAlignment="Left"/>

        <Label Content="Edad:" Margin="0,195,0,0"
               VerticalAlignment="Top" FontSize="14"/>
        <TextBox x:Name="txtEdad" Margin="140,198,0,0" Width="100"
                 Height="28" VerticalAlignment="Top" FontSize="14"
                 HorizontalAlignment="Left"
                 PreviewTextInput="txtEdad_PreviewTextInput"
                 TextChanged="txtEdad_TextChanged"/>

        <!-- Información Académica -->
        <Label Content="Carrera:" Margin="0,240,0,0"
               VerticalAlignment="Top" FontSize="14"/>
        <!-- ComboBox que carga desde BD -->
        <!-- DisplayMemberPath: muestra el nombre de la carrera -->
        <!-- SelectedValuePath: guarda el ID de la carrera seleccionada -->
        <ComboBox x:Name="cbCarrera" Margin="140,243,0,0" Width="270"
                  Height="28" VerticalAlignment="Top" FontSize="14"
                  HorizontalAlignment="Left"
                  DisplayMemberPath="Nombre"
                  SelectedValuePath="Id"/>

        <!-- Tipo de Discapacidad -->
        <Label Content="Discapacidad:" Margin="0,285,0,0"
               VerticalAlignment="Top" FontSize="14"/>
        <!-- DisplayMemberPath: muestra el nombre de la discapacidad -->
        <!-- SelectedValuePath: guarda el ID de la discapacidad seleccionada -->
        <ComboBox x:Name="cbDiscapacidad" Margin="140,288,0,0" Width="270"
                  Height="28" VerticalAlignment="Top" FontSize="14"
                  HorizontalAlignment="Left"
                  DisplayMemberPath="Nombre"
                  SelectedValuePath="Id"
                  SelectionChanged="cbDiscapacidad_SelectionChanged"/>

        <!-- Campo condicional: solo aparece si elige "Otra" -->
        <Label x:Name="lblOtraDiscapacidad" Content="Especifique:" Margin="0,330,0,0"
               VerticalAlignment="Top" FontSize="14" Visibility="Collapsed"/>
        <TextBox x:Name="txtOtraDiscapacidad" Margin="140,333,0,0" Width="270"
                 Height="28" VerticalAlignment="Top" FontSize="14"
                 HorizontalAlignment="Left" Visibility="Collapsed"/>

        <!-- Información de Contacto -->
        <Label Content="Correo:" Margin="0,375,0,0"
               VerticalAlignment="Top" FontSize="14"/>
        <TextBox x:Name="txtCorreo" Margin="140,378,0,0" Width="270"
                 Height="28" VerticalAlignment="Top" FontSize="14"
                 HorizontalAlignment="Left"
                 TextChanged="txtCorreo_TextChanged"
                 LostFocus="txtCorreo_LostFocus"/>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,10">
            <Button x:Name="btnGuardar" Content="Guardar" Width="110" Height="35" FontSize="14"
                    Margin="0,0,20,0" Click="btnGuardar_Click"
                    Background="#FF4CAF50" Foreground="White"/>
            <Button Content="Cancelar" Width="110" Height="35" FontSize="14"
                    Click="btnCancelar_Click"/>
        </StackPanel>

    </Grid>
</Window>