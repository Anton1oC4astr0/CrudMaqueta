<Window x:Class="CrudMaqueta.Views.VentanaConsulta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consulta de Alumnos" Height="560" Width="860"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Consulta de Alumnos"
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Filtrar por carrera:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cbFiltroCarrera" Width="230" Height="25"
                      SelectionChanged="cbFiltroCarrera_SelectionChanged">
                <ComboBoxItem Content="Todas" IsSelected="True"/>
                <ComboBoxItem Content="Sistemas Computacionales"/>
                <ComboBoxItem Content="Industrial"/>
                <ComboBoxItem Content="Mecatronica"/>
                <ComboBoxItem Content="Civil"/>
                <ComboBoxItem Content="Electronica"/>
            </ComboBox>

            <TextBlock Text="Filtrar por discapacidad:" VerticalAlignment="Center" Margin="20,0,8,0"/>
            <ComboBox x:Name="cbFiltroDiscapacidad" Width="180" Height="25"
                      SelectionChanged="cbFiltroDiscapacidad_SelectionChanged">
                <ComboBoxItem Content="Todas" IsSelected="True"/>
                <ComboBoxItem Content="Ninguna"/>
                <ComboBoxItem Content="Visual"/>
                <ComboBoxItem Content="Auditiva"/>
                <ComboBoxItem Content="Motriz"/>
                <ComboBoxItem Content="Cognitiva"/>
                <ComboBoxItem Content="Psicosocial"/>
                <ComboBoxItem Content="Lenguaje"/>
                <ComboBoxItem Content="Otra"/>
            </ComboBox>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="dgAlumnos"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No. Control" Binding="{Binding NumeroControl}" Width="100"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="170"/>
                <DataGridTextColumn Header="Carrera" Binding="{Binding Carrera}" Width="160"/>
                <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="170"/>
                <DataGridTextColumn Header="Discapacidad" Binding="{Binding Discapacidad}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="btnGenerarReporte" Content="Generar Reporte PDF"
                    Width="180" Height="35" Margin="0,0,15,0"
                    Background="#FF1B5E20" Foreground="White"
                    Click="btnGenerarReporte_Click"/>
            <Button x:Name="btnCerrar" Content="Cerrar"
                    Width="120" Height="35"
                    Click="btnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
