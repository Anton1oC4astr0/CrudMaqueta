<Window x:Class="CrudMaqueta.Views.VentanaCambios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Alumno" Height="580" Width="520"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30,30,30,10">

        <Label Content="Editar Alumno" FontSize="22" FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <!-- Identificación -->

        <Label Content="No. Control:" Margin="0,60,0,0"
               VerticalAlignment="Top" FontSize="14"/>

        <TextBox x:Name="txtNumControl" Margin="140,63,0,0" Width="300"
                 Height="28" VerticalAlignment="Top" FontSize="14"
                 HorizontalAlignment="Left"
                 IsReadOnly="True" Background="#FFE5E5E5"/>

        <!-- Información Personal -->

        <Label Content="Nombre:" Margin="0,105,0,0"
               VerticalAlignment="Top" FontSize="14"/>
        <TextBox x:Name="txtNombre" Margin="140,108,0,0" Width="300"
                 Height="28" VerticalAlignment="Top" FontSize="14"
                 HorizontalAlignment="Left"/>

        <Label Content="Fecha Nac:" Margin="0,150,0,0"
               VerticalAlignment="Top" FontSize="14"/>
        <DatePicker x:Name="dpFechaNac" Margin="140,153,0,0" Width="300"
                    Height="28" VerticalAlignment="Top" FontSize="14"
                    HorizontalAlignment="Left"/>

        <Label Content="Edad:" Margin="0,195,0,0"
               VerticalAlignment="Top" FontSize="14"/>

        <TextBox x:Name="txtEdad" Margin="140,198,0,0" Width="100"
                 Height="28" VerticalAlignment="Top" FontSize="14"
                 HorizontalAlignment="Left"
                 PreviewTextInput="txtEdad_PreviewTextInput"
                 TextChanged="txtEdad_TextChanged"/>

        <TextBlock x:Name="lblErrorEdad" Margin="250,204,0,0" Width="200"
                   VerticalAlignment="Top" FontSize="11" Foreground="Red"
                   HorizontalAlignment="Left" Visibility="Collapsed"/>

        <!-- Información Académica -->

        <Label Content="Carrera:" Margin="0,240,0,0"
               VerticalAlignment="Top" FontSize="14"/>

        <ComboBox x:Name="cbCarrera" Margin="140,243,0,0" Width="300"
                  Height="28" VerticalAlignment="Top" FontSize="14"
                  HorizontalAlignment="Left"
                  DisplayMemberPath="Nombre"
                  SelectedValuePath="Id"/>

        <!-- Discapacidad -->

        <Label Content="Discapacidad:" Margin="0,298,0,0"
               VerticalAlignment="Top" FontSize="14"/>

        <ComboBox x:Name="cbDiscapacidad" Margin="140,299,0,0" Width="300"
                  Height="28" VerticalAlignment="Top" FontSize="14"
                  HorizontalAlignment="Left"
                  DisplayMemberPath="Nombre"
                  SelectedValuePath="Id"
                  SelectionChanged="cbDiscapacidad_SelectionChanged"/>

        <Label x:Name="lblOtraDiscapacidad" Content="Especifique:"
               Margin="0,330,0,0" VerticalAlignment="Top" FontSize="14"
               Visibility="Collapsed"/>
        <TextBox x:Name="txtOtraDiscapacidad" Margin="140,333,0,0" Width="300"
                 Height="28" VerticalAlignment="Top" FontSize="14"
                 HorizontalAlignment="Left" Visibility="Collapsed"/>

        <!-- Contacto -->

        <Label Content="Correo:" Margin="0,347,0,0"
               VerticalAlignment="Top" FontSize="14"/>

        <TextBox x:Name="txtCorreo" Margin="140,347,0,0" Width="300"
                 Height="28" VerticalAlignment="Top" FontSize="14"
                 HorizontalAlignment="Left"
                 TextChanged="txtCorreo_TextChanged"/>
        <TextBlock x:Name="lblErrorCorreo" Margin="140,410,0,0" Width="300"
                   VerticalAlignment="Top" FontSize="11" Foreground="Red"
                   HorizontalAlignment="Left" Visibility="Collapsed"
                   TextWrapping="Wrap"/>

        <!-- Acciones -->

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Margin="0,436,0,0">

            <Button x:Name="btnActualizar" Content="Actualizar"
                    Width="120" Height="35" FontSize="14" Margin="0,0,15,0"
                    Click="btnActualizar_Click"
                    Background="#FF2196F3" Foreground="White"/>
            <Button Content="Cancelar" Width="120" Height="35" FontSize="14"
                    Click="btnCancelar_Click"/>
        </StackPanel>

    </Grid>
</Window>