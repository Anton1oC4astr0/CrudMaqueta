<Window x:Class="CrudMaqueta.Views.VentanaCambiosBajas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambios y Bajas" Height="540" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
     
        <TextBlock Grid.Row="0" x:Name="lblTitulo"
                   Text="Modificar Alumnos"
                   FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Búsqueda -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">

            <TextBlock Text="Carrera:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cbFiltroCarrera" Width="200" Height="26" Margin="0,0,20,0"
              DisplayMemberPath="Nombre"
              SelectedValuePath="Id"/>

            <TextBlock Text="No. Control:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="txtBuscarControl" Width="150" Height="26" Margin="0,0,8,0"
             ToolTip="Buscar por número de control"
             PreviewTextInput="txtBuscarControl_PreviewTextInput"/>

            <Button x:Name="btnBuscar" Content="Buscar"
            Width="90" Height="28" Click="btnBuscar_Click"/>
            <Button x:Name="btnLimpiar" Content="Limpiar"
            Width="90" Height="28" Margin="6,0,0,0" Click="btnLimpiar_Click"/>

        </StackPanel>

        <!--
            Desde code-behind se actualiza el texto y color según el resultado:
            - Sin buscar     → "Realiza una búsqueda..." (gris)
            - Con resultados → "Se encontraron X alumnos." (negro)
            - Sin resultados → "No se encontraron resultados." (rojo)
        -->
        <TextBlock Grid.Row="2" x:Name="lblEstado"
                   Text="Realiza una búsqueda para mostrar resultados."
                   Foreground="Gray" FontStyle="Italic" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="3" x:Name="lblErrorSeleccion"
                   Text="Selecciona un alumno de la lista antes de continuar."
                   Foreground="Red" FontSize="12"
                   Visibility="Collapsed" Margin="0,0,0,6"/>
      
        <DataGrid Grid.Row="4" x:Name="dgAlumnos"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No. Control"  Binding="{Binding NumeroControl}" Width="100"/>
                <DataGridTextColumn Header="Nombre"       Binding="{Binding Nombre}"        Width="*"/>
                <DataGridTextColumn Header="Carrera"      Binding="{Binding Carrera}"        Width="*"/>
                <DataGridTextColumn Header="Correo"       Binding="{Binding Correo}"         Width="150"/>
                <DataGridTextColumn Header="Discapacidad" Binding="{Binding Discapacidad}"   Width="110"/>
                <DataGridTextColumn Header="Fecha Nac."   Binding="{Binding FechaNacimiento, StringFormat=dd/MM/yyyy}" Width="95"/>
                <DataGridTextColumn Header="Edad"         Binding="{Binding Edad}"           Width="55"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="btnAccion" Content="Modificar"
                    Width="140" Height="35" Margin="5"
                    Click="btnAccion_Click"
                    Background="#FF2196F3" Foreground="White"/>
            <Button x:Name="btnCerrar" Content="Cerrar"
                    Width="120" Height="35" Margin="5"
                    Click="btnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>