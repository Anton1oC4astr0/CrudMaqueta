<Window x:Class="CrudMaqueta.Views.VentanaCambiosBajas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambios y Bajas" Height="540" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título dinámico (Modificar / Eliminar) -->
        <TextBlock Grid.Row="0" x:Name="lblTitulo"
                   Text="Modificar Alumnos"
                   FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Búsqueda: por número de control o carrera -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="No. Control:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="txtBuscarControl" Width="160" Height="26" Margin="0,0,15,0"
                     ToolTip="Buscar por número de control"/>

            <TextBlock Text="Carrera:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cbFiltroCarrera" Width="220" Height="26" Margin="0,0,15,0">
                <ComboBoxItem Content="Todas" IsSelected="True"/>
                <ComboBoxItem Content="Sistemas Computacionales"/>
                <ComboBoxItem Content="Industrial"/>
                <ComboBoxItem Content="Electronica"/>
                <ComboBoxItem Content="Civil"/>
                <ComboBoxItem Content="Mecatronica"/>
            </ComboBox>

            <Button x:Name="btnBuscar" Content="Buscar"
                    Width="90" Height="28" Click="btnBuscar_Click"/>
            <Button x:Name="btnLimpiar" Content="Limpiar"
                    Width="90" Height="28" Margin="6,0,0,0" Click="btnLimpiar_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="lblEstado"
                   Text="Realiza una búsqueda para mostrar resultados."
                   Foreground="Gray" FontStyle="Italic" Margin="0,0,0,8"/>

        <!-- Tabla de resultados (inicia VACÍA) -->
        <DataGrid Grid.Row="3" x:Name="dgAlumnos"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No. Control" Binding="{Binding NumeroControl}" Width="100"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="170"/>
                <DataGridTextColumn Header="Carrera" Binding="{Binding Carrera}" Width="160"/>
                <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="160"/>
                <DataGridTextColumn Header="Discapacidad" Binding="{Binding Discapacidad}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- SOLO un botón de acción (Modificar o Eliminar) según el modo -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="btnAccion" Content="Modificar"
                    Width="140" Height="35" Margin="5"
                    Click="btnAccion_Click"/>
            <Button x:Name="btnCerrar" Content="Cerrar"
                    Width="120" Height="35" Margin="5"
                    Click="btnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
