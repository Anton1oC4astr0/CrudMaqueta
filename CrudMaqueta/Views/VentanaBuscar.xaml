<Window x:Class="CrudMaqueta.Views.VentanaBuscar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar Alumno" Height="248" Width="484"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30">

        <Label x:Name="lblTitulo" Content="Buscar Alumno"
               FontSize="20" FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <Label Content="No. Control:" Margin="0,65,0,0"
               VerticalAlignment="Top" FontSize="14"/>
        <TextBox x:Name="txtBuscar" Margin="130,68,0,0" Width="240"
                 Height="30" VerticalAlignment="Top" FontSize="14"
                 HorizontalAlignment="Left"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,10">
            <Button Content="Buscar" Width="110" Height="35" FontSize="14"
                    Margin="0,0,20,0" Click="btnBuscar_Click"/>
            <Button Content="Cancelar" Width="110" Height="35" FontSize="14"
                    Click="btnCancelar_Click"/>
        </StackPanel>

    </Grid>
</Window>
