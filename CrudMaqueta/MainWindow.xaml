<Window x:Class="CrudMaqueta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Alumnos" Height="540" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Image Source="Resources/mi_logo.png"
               Height="70" Width="70"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,15,0,0"/>

        <Label Content="Sistema de Control Escolar"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,95,0,0" FontSize="20" FontWeight="Bold"/>

        <Label Content="Selecciona una operación:"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,135,0,0" FontSize="13" Foreground="Gray"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,170,0,0" Width="240">
            <Button Content="Altas" Height="40" Margin="0,5" FontSize="14" Click="btnAltas_Click"/>
            <Button Content="Consulta" Height="40" Margin="0,5" FontSize="14" Click="btnConsulta_Click"/>
            <Button Content="Cambios" Height="40" Margin="0,5" FontSize="14" Click="btnCambios_Click"/>
            <Button Content="Bajas" Height="40" Margin="0,5" FontSize="14" Click="btnBajas_Click"/>
        </StackPanel>
    </Grid>
</Window>
